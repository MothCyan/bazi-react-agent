# 环境变量示例：复制为 .env 后按需修改（.env 已被 .gitignore 排除）
# 生产/开发启动时可用：node --env-file=.env server/index.js

# 后端监听端口（默认 3001）
PORT=3001

# 监听地址：默认 127.0.0.1（仅本机，供隧道客户端连接）；
# 需要同一局域网访问时改为 0.0.0.0
HOST=127.0.0.1

# 服务端数据目录，模型配置与访问令牌保存在这里（默认 ./data）
BAZI_DATA_DIR=data

# 可选的模型默认值。网页「模型设置」中保存的配置优先级更高，
# 只有 data/config.json 不存在时才使用以下默认值。
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# 访问令牌：留空则读取 data/access.json（用 npm run token 生成）。
# 公网穿透时务必设置，否则任何拿到链接的人都能消耗你的模型额度。
BAZI_ACCESS_TOKEN=

# 额外的允许来源（逗号分隔），用于自定义域名等场景。
# 同源的 http/https 写法已自动放行，通常无需配置。
BAZI_ALLOWED_ORIGINS=

# 单次模型请求超时（毫秒，默认 30000）
BAZI_LLM_TIMEOUT_MS=30000

# 一次完整分析的时长上限（毫秒，默认 90000），超时后回退规则报告
BAZI_ANALYZE_DEADLINE_MS=90000

